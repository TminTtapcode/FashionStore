# Database Configuration (MySQL 8.x)
MYSQL_DATABASE=fashion_store
MYSQL_USER=fashion_user
MYSQL_PASSWORD=fashion_password
MYSQL_ROOT_PASSWORD=root_secret_password
MYSQL_PORT=3306
MYSQL_HOST=localhost

# Backend Spring Boot Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://localhost:3306/fashion_store?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=fashion_user
DB_PASSWORD=fashion_password

# Authentication / Security
AUTH_COOKIE_NAME=fs_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
# JWT Secret (minimum 256-bit / 32 bytes string for HMAC-SHA256)
JWT_SECRET=fashion_store_development_jwt_secret_key_needs_to_be_at_least_32_bytes_long!
JWT_EXPIRATION_SECONDS=86400

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=fashion_store/products

